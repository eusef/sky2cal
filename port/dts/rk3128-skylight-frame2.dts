/*
 * Skylight Frame 2 (RK3128, 512 MB, 800x1280 MIPI DSI panel).
 *
 * Bring-up stage 2: no display driver yet. The stock U-Boot lights the panel
 * from its own copy of the vendor device tree and leaves a framebuffer at
 * 0x7dc00000; simple-framebuffer reuses it for the console. This tree is
 * appended to the zImage, so U-Boot's fixups (memory, bootargs) do not apply.
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include "rk3128.dtsi"

/ {
	model = "Skylight Frame 2";
	compatible = "skylight,frame2", "rockchip,rk3128";

	aliases {
		mmc0 = &emmc;
	};

	memory@60000000 {
		device_type = "memory";
		reg = <0x60000000 0x20000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* U-Boot logo area: uboot_logo=0x02000000@0x7dc00000 */
		uboot_fb: framebuffer@7dc00000 {
			reg = <0x7dc00000 0x02000000>;
			no-map;
		};
	};

	chosen {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
		/*
		 * The eMMC has no partition table mainline understands (Rockchip "parameter" block).
		 * blkdevparts exposes only the last partition, "user" (raw sector 4866048, 10076160
		 * sectors, verified against the full-disk backup), as mmcblk0p1: the Debian root.
		 */
		bootargs = "console=ttyS2,115200n8 console=ttyGS0,115200 console=tty0 clk_ignore_unused pd_ignore_unused ignore_loglevel rdinit=/init blkdevparts=mmcblk0:5158993920@2491416576(user)";

		/* RGB565 confirmed on the panel. U-Boot's window is only 240x750; init widens it. */
		framebuffer@7dc00000 {
			compatible = "simple-framebuffer";
			reg = <0x7dc00000 (800 * 1280 * 2)>;
			width = <800>;
			height = <1280>;
			stride = <(800 * 2)>;
			format = "r5g6b5";
		};
	};
};

/ {
	/* Vendor tree: PWM1, 25 us period, levels 0-255, default 128, no enable GPIO. */
	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm1 0 25000 0>;
		brightness-levels = <0 255>;
		num-interpolated-steps = <255>;
		default-brightness-level = <128>;
	};

	gpio-keys {
		compatible = "gpio-keys";

		key-power {
			label = "power";
			gpios = <&gpio0 RK_PA5 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_POWER>;
			wakeup-source;
		};
	};

	/*
	 * BCM43455: WL_REG_ON on GPIO3_D3 (high = on). The vendor tree's "reset" pin GPIO0_B6 is
	 * left as U-Boot sets it (output, low): its required level is not known yet.
	 * The vendor tree names no 32 kHz source. ASSUMED: if it is the RTC's CLKOUT, this
	 * reference keeps it running (the hym8563 driver stops CLKOUT when nothing uses it).
	 */
	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <&hym8563>;
		clock-names = "ext_clock";
		reset-gpios = <&gpio3 RK_PD3 GPIO_ACTIVE_LOW>;
	};
};

&cpu0 {
	cpu-supply = <&vdd_arm>;
};

&cpu1 {
	cpu-supply = <&vdd_arm>;
};

&cpu2 {
	cpu-supply = <&vdd_arm>;
};

&cpu3 {
	cpu-supply = <&vdd_arm>;
};

&emmc {
	bus-width = <8>;
	cap-mmc-highspeed;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&emmc_clk &emmc_cmd &emmc_bus8>;
	status = "okay";
};

/*
 * PMIC and RTC. Every rail is always-on with the vendor tree's limits, so the kernel never
 * switches one off. GPIO3_C1 (PMIC sleep in the vendor tree, also its "gpio_poweroff") is
 * left alone; power-off goes through the PMIC.
 */
&i2c0 {
	status = "okay";

	rk805: pmic@18 {
		compatible = "rockchip,rk805";
		reg = <0x18>;
		interrupt-parent = <&gpio1>;
		interrupts = <RK_PB1 IRQ_TYPE_LEVEL_LOW>;
		system-power-controller;
		gpio-controller;
		#gpio-cells = <2>;

		regulators {
			vdd_logic: DCDC_REG1 {
				regulator-name = "vdd_logic";
				regulator-min-microvolt = <700000>;
				regulator-max-microvolt = <1500000>;
				regulator-always-on;
				regulator-boot-on;
			};

			vdd_arm: DCDC_REG2 {
				regulator-name = "vdd_arm";
				regulator-min-microvolt = <700000>;
				regulator-max-microvolt = <1500000>;
				regulator-always-on;
				regulator-boot-on;
			};

			vcc_ddr: DCDC_REG3 {
				regulator-name = "vcc_ddr";
				regulator-always-on;
				regulator-boot-on;
			};

			vcc_io: DCDC_REG4 {
				regulator-name = "vcc_io";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
				regulator-boot-on;
			};

			LDO_REG1 {
				regulator-name = "rk805_ldo1";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
				regulator-boot-on;
			};

			LDO_REG2 {
				regulator-name = "rk805_ldo2";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				regulator-boot-on;
			};

			LDO_REG3 {
				regulator-name = "rk805_ldo3";
				regulator-min-microvolt = <1100000>;
				regulator-max-microvolt = <1100000>;
				regulator-always-on;
				regulator-boot-on;
			};
		};
	};

	hym8563: rtc@51 {
		compatible = "haoyu,hym8563";
		reg = <0x51>;
		interrupt-parent = <&gpio2>;
		interrupts = <RK_PB4 IRQ_TYPE_EDGE_FALLING>;
		#clock-cells = <0>;
		clock-output-names = "hym8563";
	};
};

/* Goodix GT9xx, reports 1280x800 (landscape); orientation is handled by the app. */
&i2c2 {
	status = "okay";

	touchscreen@14 {
		compatible = "goodix,gt911";
		reg = <0x14>;
		interrupt-parent = <&gpio1>;
		interrupts = <RK_PB0 IRQ_TYPE_LEVEL_LOW>;
		irq-gpios = <&gpio1 RK_PB0 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio0 RK_PD1 GPIO_ACTIVE_HIGH>;
	};
};

&pwm1 {
	status = "okay";
};

&sdio {
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	max-frequency = <37500000>;
	mmc-pwrseq = <&sdio_pwrseq>;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&sdio_clk &sdio_cmd &sdio_bus4>;
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	wifi@1 {
		compatible = "brcm,bcm4329-fmac";
		reg = <1>;
	};
};

&uart2 {
	status = "okay";
};

&usb_otg {
	dr_mode = "peripheral";
	status = "okay";
};

&usb2phy {
	status = "okay";
};

&usb2phy_otg {
	status = "okay";
};
