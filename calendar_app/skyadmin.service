[Unit]
Description=Skylight frame settings page (USB cable, and Wi-Fi after the frame's QR code)
After=network.target

[Service]
# Runs as root: it rewrites the root-only calendar and Wi-Fi configs and restarts services.
# It listens on the usb0 address (port 80, which the firewall admits from usb0 only) and on port
# 8080 for phones (admitted from wlan0 only), where it lets in only the holder of the QR code
# the calendar shows (skycal/remote.py).
WorkingDirectory=/opt/skycal
ExecStart=/usr/bin/python3 -m skyadmin
# Restart=always also covers a start before usb0 has its address.
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
# /var/lib/skycal: to drop a look picked on the frame when the page saves a style (skycal/themes).
ReadWritePaths=/etc/skycal /etc/wpa_supplicant -/var/lib/skycal
ProtectHome=yes
PrivateTmp=yes
# AF_UNIX for systemctl, AF_NETLINK for iw and ip.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
MemoryMax=64M

[Install]
WantedBy=multi-user.target
