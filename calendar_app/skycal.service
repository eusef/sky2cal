[Unit]
Description=Skylight family calendar display
After=systemd-udev-settle.service network.target
Wants=systemd-udev-settle.service

[Service]
User=skycal
Group=skycal
SupplementaryGroups=video input
StateDirectory=skycal
StateDirectoryMode=0700
# The config holds the secret calendar address: root-only on disk, handed over as a credential.
LoadCredential=config:/etc/skycal/config.toml
WorkingDirectory=/opt/skycal
# Stop the kernel text console from drawing over the calendar ("+" = run as root).
ExecStartPre=+/bin/sh -c 'for c in /sys/class/vtconsole/vtcon*; do grep -q "frame buffer" $$c/name && echo 0 > $$c/bind; done; true'
ExecStart=/usr/bin/python3 -m skycal.frame --config %d/config --cache-dir /var/lib/skycal
Restart=always
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=200M

[Install]
WantedBy=multi-user.target
